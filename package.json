{
	"name": "@taktik/taktik-flowr-react-utils",
	"version": "1.0.4",
	"description": "Taktik React utils for FlowR apps: arrow-key navigation hook and legacy-safe flexbox mixins",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/taktik/taktik-flowr-react-utils.git"
	},
	"private": false,
	"author": "Arnaud Gathy",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.13",
		"@babel/preset-env": "^7.29.14",
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^4.33.0",
		"@typescript-eslint/parser": "^4.33.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^7.32.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-config-standard": "^16.0.3",
		"eslint-plugin-html": "^6.2.0",
		"eslint-plugin-import": "^2.24.2",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-promise": "^5.1.0",
		"eslint-plugin-react": "^7.26.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-standard": "^5.0.0",
		"husky": "^7.0.2",
		"lint-staged": "^11.2.0",
		"prettier": "^2.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"styled-components": "^6.1.8",
		"taktik_flowr_interface": "7.0.0-alpha.0",
		"typescript": "^5.3.3"
	},
	"peerDependencies": {
		"@types/react": ">=19.0",
		"@types/react-dom": ">=19.0",
		"react": ">=19.0",
		"react-dom": ">=19.0",
		"styled-components": ">=5.0",
		"taktik_flowr_interface": ">=7.0.0-alpha.0"
	},
	"scripts": {
		"start": "cd demo && yarn start",
		"build": "rm -rf dist && babel src --out-dir dist --extensions .ts,.tsx && tsc --emitDeclarationOnly",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src --ext .ts,.tsx --max-warnings 0",
		"prepare": "husky install",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"registry": "https://npm.taktik.be/repository/npm/"
	}
}
